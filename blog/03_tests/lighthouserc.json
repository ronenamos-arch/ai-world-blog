{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/", "/posts/welcome/"],
      "numberOfRuns": 3
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 150
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
